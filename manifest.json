{
    "manifest_version":  3,
    "name":  "Facet: diamond size and report check",
    "version":  "0.5.0",
    "description":  "Decode diamond size on any listing, create a comparison brief, and verify reports on the grading lab\u0027s own site.",
    "action":  {
                   "default_popup":  "popup.html",
                   "default_title":  "Facet",
                   "default_icon":  {
                                        "16":  "icons/icon16.png",
                                        "48":  "icons/icon48.png"
                                    }
               },
    "permissions":  [
                        "activeTab",
                        "scripting"
                    ],
    "host_permissions":  [

                         ],
    "icons":  {
                  "16":  "icons/icon16.png",
                  "48":  "icons/icon48.png",
                  "128":  "icons/icon128.png"
              }
}
